#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)
export DOTFILES_ROOT

set -e

echo ''

source "$DOTFILES_ROOT/script/lib/output.sh"
source "$DOTFILES_ROOT/script/lib/links.sh"

setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}

install_agents_dir () {
  if [ -d "$DOTFILES_ROOT/agents" ]
  then
    info 'linking agents directory'
    local overwrite_all=false backup_all=false skip_all=false
    link_file "$DOTFILES_ROOT/agents" "$HOME/.agents"
  fi
  if [ -d "$HOME/.cursor" ]
  then
    info 'linking cursor directory'
    local overwrite_all=false backup_all=false skip_all=false
    link_file "$DOTFILES_ROOT/agents/skills" "$HOME/.cursor/skills"
    link_file "$DOTFILES_ROOT/agents/prompts" "$HOME/.cursor/prompts"
    link_file "$DOTFILES_ROOT/agents/commands" "$HOME/.cursor/commands"
  fi
}

link_my_skills () {
  if [ -d "$DOTFILES_ROOT/agents/my-skills" ]
  then
    info 'linking own skills into agents/skills'
    local overwrite_all=false backup_all=false skip_all=false
    for skill_dir in "$DOTFILES_ROOT/agents/my-skills"/*/
    do
      [ -d "$skill_dir" ] || continue
      local skill_name
      skill_name="$(basename "$skill_dir")"
      link_file "$skill_dir" "$DOTFILES_ROOT/agents/skills/$skill_name"
    done

    for link in "$DOTFILES_ROOT/agents/skills"/*/
    do
      link="${link%/}"
      [ -L "$link" ] || continue
      if [ ! -e "$link" ]
      then
        rm "$link"
        success "pruned stale skill symlink $link"
      fi
    done
  fi
}

install_pi_dir () {
  if [ -d "$DOTFILES_ROOT/pi" ]
  then
    info 'linking pi config'
    local overwrite_all=false backup_all=false skip_all=false
    local pi_agent="$HOME/.pi/agent"
    mkdir -p "$pi_agent/extensions" "$pi_agent/skills"

    link_file "$DOTFILES_ROOT/pi/agent/settings.json" "$pi_agent/settings.json"
    link_file "$DOTFILES_ROOT/pi/agent/mcp.json" "$pi_agent/mcp.json"

    # mcp.local.json holds machine-specific mcpServers (secrets, per-host servers).
    # It's gitignored via *.local.* and symlinked into pi's user-global shared
    # MCP config location so pi-mcp-adapter picks it up alongside the tracked
    # imports-only mcp.json.
    if [ -f "$DOTFILES_ROOT/pi/agent/mcp.local.json" ]
    then
      mkdir -p "$HOME/.config/mcp"
      link_file "$DOTFILES_ROOT/pi/agent/mcp.local.json" "$HOME/.config/mcp/mcp.json"
    fi

    link_file "$DOTFILES_ROOT/pi/agent/prompts" "$pi_agent/prompts"
    link_file "$DOTFILES_ROOT/pi/agent/themes" "$pi_agent/themes"
    link_file "$DOTFILES_ROOT/pi/agent/extensions/rtk.ts" "$pi_agent/extensions/rtk.ts"

    for skill_dir in "$DOTFILES_ROOT/pi/agent/skills"/*/
    do
      [ -d "$skill_dir" ] || continue
      skill_dir="${skill_dir%/}"   # trailing slash breaks readlink comparison in link_file
      link_file "$skill_dir" "$pi_agent/skills/$(basename "$skill_dir")"
    done

    # prune stale symlinks that pointed into this repo's pi skills
    for link in "$pi_agent/skills"/*
    do
      [ -L "$link" ] || continue
      case "$(readlink "$link")" in
        "$DOTFILES_ROOT"/pi/agent/skills/*)
          if [ ! -e "$link" ]
          then
            rm "$link"
            success "pruned stale pi skill symlink $link"
          fi
          ;;
      esac
    done
  fi
}

setup_gitconfig
install_dotfiles
install_agents_dir
link_my_skills
install_pi_dir

# If we're on a Mac, let's install and setup homebrew.
if [ "$(uname -s)" == "Darwin" ]
then
  info "installing dependencies"
  if source bin/dot | while read -r data; do info "$data"; done
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

echo ''
echo '  ✅ All installed!'
